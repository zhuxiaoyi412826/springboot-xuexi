<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    小说 Mapper XML —— 本项目复杂 SQL 的集中展示区

    涵盖知识点：
      1. <resultMap> 自定义映射 + <association> 一对一多表映射
      2. <sql> + <include> 片段复用
      3. <where> <if> <choose>/<when>/<otherwise> <foreach> <set> <trim> <bind> 动态 SQL
      4. 子查询、EXISTS
      5. SQL 函数：COUNT / SUM / AVG / MAX / MIN / IFNULL / CONCAT / DATE_FORMAT
      6. 自定义 TypeHandler（tags 字段）
      7. <cache> 二级缓存 + useCache / flushCache 控制
-->
<mapper namespace="org.example.mybatis.mapper.NovelMapper">

    <!-- ============ 二级缓存 ============ -->
    <!-- LRU 淘汰，10 分钟自动刷新，最多 1024 个对象；readOnly=false 表示返回副本（更安全） -->
    <cache eviction="LRU" flushInterval="600000" size="1024" readOnly="false"/>

    <!-- ============ 可复用片段 ============ -->

    <!-- 通用查询列（带分类名、我是否收藏、最新章节） -->
    <sql id="NovelColumns">
        n.id, n.title, n.author, n.category_id, n.tags, n.cover_url, n.description,
        n.word_count, n.chapter_count, n.status, n.view_count, n.favorite_count,
        n.download_count, n.file_path, n.create_time, n.update_time
    </sql>

    <!-- 动态查询条件：所有 if 都可以不成立 -->
    <sql id="NovelWhere">
        <where>
            AND n.deleted = 0
            <if test="keyword != null and keyword != ''">
                AND (n.title LIKE CONCAT('%', #{keyword}, '%')
                  OR n.author LIKE CONCAT('%', #{keyword}, '%')
                  OR n.description LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="categoryId != null">
                AND n.category_id = #{categoryId}
            </if>
            <if test="categoryIds != null and categoryIds.size() &gt; 0">
                AND n.category_id IN
                <foreach collection="categoryIds" item="cid" open="(" separator="," close=")">
                    #{cid}
                </foreach>
            </if>
            <if test="author != null and author != ''">
                AND n.author = #{author}
            </if>
            <if test="status != null and status != ''">
                AND n.status = #{status}
            </if>
            <!-- 标签：任意一个命中即可 -->
            <if test="tags != null and tags.size() &gt; 0">
                AND (
                <foreach collection="tags" item="t" separator=" OR ">
                    n.tags LIKE CONCAT('%', #{t}, '%')
                </foreach>
                )
            </if>
            <if test="minWordCount != null">
                AND n.word_count &gt;= #{minWordCount}
            </if>
            <if test="maxWordCount != null">
                AND n.word_count &lt;= #{maxWordCount}
            </if>
            <!-- EXISTS 子查询：只查有章节的小说 -->
            <if test="hasChapter != null and hasChapter">
                AND EXISTS (SELECT 1 FROM chapter ch WHERE ch.novel_id = n.id)
            </if>
        </where>
    </sql>

    <!-- 动态排序：用白名单枚举，绝不直接拼接 ${} 参数，避免 SQL 注入 -->
    <sql id="NovelOrderBy">
        <choose>
            <when test="orderBy == 'hot'">ORDER BY (n.view_count + n.favorite_count * 10) DESC</when>
            <when test="orderBy == 'views'">ORDER BY n.view_count DESC</when>
            <when test="orderBy == 'favorite'">ORDER BY n.favorite_count DESC</when>
            <when test="orderBy == 'download'">ORDER BY n.download_count DESC</when>
            <when test="orderBy == 'word'">ORDER BY n.word_count DESC</when>
            <when test="orderBy == 'new'">ORDER BY n.create_time DESC</when>
            <when test="orderBy == 'random'">ORDER BY RAND()</when>
            <otherwise>ORDER BY n.id DESC</otherwise>
        </choose>
    </sql>

    <!-- ============ resultMap ============ -->

    <!-- 列表 VO：tags 用自定义 TypeHandler 映射 -->
    <resultMap id="NovelVOMap" type="org.example.mybatis.dto.NovelVO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="author" property="author"/>
        <result column="category_id" property="categoryId"/>
        <result column="category_name" property="categoryName"/>
        <result column="tags" property="tags" typeHandler="org.example.mybatis.type.TagsTypeHandler"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="description" property="description"/>
        <result column="word_count" property="wordCount"/>
        <result column="chapter_count" property="chapterCount"/>
        <result column="status" property="status"/>
        <result column="view_count" property="viewCount"/>
        <result column="favorite_count" property="favoriteCount"/>
        <result column="download_count" property="downloadCount"/>
        <result column="create_time" property="createTime"/>
        <result column="favorited" property="favorited"/>
        <result column="latest_chapter" property="latestChapter"/>
    </resultMap>

    <!-- 详情 VO：<association> 演示一对一嵌套映射（NovelDetailVO 里的 category 对象） -->
    <resultMap id="NovelDetailMap" type="org.example.mybatis.dto.NovelDetailVO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="author" property="author"/>
        <result column="category_id" property="categoryId"/>
        <result column="category_name" property="categoryName"/>
        <result column="tags" property="tags" typeHandler="org.example.mybatis.type.TagsTypeHandler"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="description" property="description"/>
        <result column="word_count" property="wordCount"/>
        <result column="chapter_count" property="chapterCount"/>
        <result column="status" property="status"/>
        <result column="view_count" property="viewCount"/>
        <result column="favorite_count" property="favoriteCount"/>
        <result column="download_count" property="downloadCount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="favorited" property="favorited"/>
        <result column="my_chapter_no" property="myChapterNo"/>
        <result column="my_progress" property="myProgress"/>
        <result column="first_chapter_id" property="firstChapterId"/>
        <result column="latest_chapter_id" property="latestChapterId"/>
        <result column="latest_chapter_title" property="latestChapterTitle"/>
        <association property="category" javaType="org.example.mybatis.entity.Category">
            <id column="cat_id" property="id"/>
            <result column="category_name" property="name"/>
            <result column="cat_description" property="description"/>
        </association>
    </resultMap>

    <!-- ============ SQL 语句 ============ -->

    <!-- 多条件检索：多表 JOIN + 子查询 + 动态条件 + 动态排序 -->
    <!-- useCache=false：检索结果随收藏/阅读变化频繁，不走二级缓存，保证数据实时 -->
    <select id="selectByCondition" resultMap="NovelVOMap" useCache="false">
        SELECT
            <include refid="NovelColumns"/>,
            c.name AS category_name,
            (SELECT COUNT(*) FROM favorite f WHERE f.novel_id = n.id AND f.user_id = #{userId}) AS favorited,
            (SELECT ch.title FROM chapter ch WHERE ch.novel_id = n.id ORDER BY ch.chapter_no DESC LIMIT 1) AS latest_chapter
        FROM novel n
        LEFT JOIN category c ON c.id = n.category_id AND c.deleted = 0
        <include refid="NovelWhere"/>
        <include refid="NovelOrderBy"/>
    </select>

    <!-- 详情：多表 LEFT JOIN + 多个标量子查询 -->
    <!--
        useCache="false"：详情页要实时反映浏览量 / 收藏数，不能读二级缓存的旧值。
        二级缓存原则：读多写少的数据才适合缓存；实时计数类数据不要缓存。
    -->
    <select id="selectDetail" resultMap="NovelDetailMap" useCache="false">
        SELECT
            <include refid="NovelColumns"/>,
            c.id AS cat_id,
            c.name AS category_name,
            c.description AS cat_description,
            h.chapter_no AS my_chapter_no,
            h.progress AS my_progress,
            (SELECT MIN(ch.id) FROM chapter ch WHERE ch.novel_id = n.id) AS first_chapter_id,
            (SELECT ch.id FROM chapter ch WHERE ch.novel_id = n.id ORDER BY ch.chapter_no DESC LIMIT 1) AS latest_chapter_id,
            (SELECT ch.title FROM chapter ch WHERE ch.novel_id = n.id ORDER BY ch.chapter_no DESC LIMIT 1) AS latest_chapter_title,
            (SELECT COUNT(*) FROM favorite f WHERE f.novel_id = n.id AND f.user_id = #{userId}) AS favorited
        FROM novel n
        LEFT JOIN category c ON c.id = n.category_id AND c.deleted = 0
        LEFT JOIN reading_history h ON h.novel_id = n.id AND h.user_id = #{userId}
        WHERE n.id = #{novelId} AND n.deleted = 0
    </select>

    <!-- 热门 TOP N：可以走二级缓存（短时间内变化不大） -->
    <select id="selectHotTop" resultMap="NovelVOMap">
        SELECT
            <include refid="NovelColumns"/>,
            c.name AS category_name,
            0 AS favorited,
            NULL AS latest_chapter
        FROM novel n
        LEFT JOIN category c ON c.id = n.category_id AND c.deleted = 0
        <where>
            AND n.deleted = 0
            <if test="categoryId != null">
                AND n.category_id = #{categoryId}
            </if>
        </where>
        ORDER BY n.view_count DESC
        LIMIT #{limit}
    </select>

    <!-- 动态更新：<set> 会自动去掉末尾多余的逗号，只更新非空字段 -->
    <update id="updateSelective" flushCache="true">
        UPDATE novel
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="author != null">author = #{author},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="tags != null">tags = #{tags,typeHandler=org.example.mybatis.type.TagsTypeHandler},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="filePath != null">file_path = #{filePath},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id} AND deleted = 0
    </update>

    <!-- 批量插入：<foreach> 一条 SQL 插入多行 -->
    <insert id="batchInsert">
        INSERT INTO novel (title, author, category_id, tags, cover_url, description, status)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.title}, #{item.author}, #{item.categoryId},
             #{item.tags,typeHandler=org.example.mybatis.type.TagsTypeHandler},
             #{item.coverUrl}, #{item.description}, #{item.status})
        </foreach>
    </insert>

    <!-- 批量逻辑删除：<foreach> 构造 IN -->
    <update id="batchLogicDelete" flushCache="true">
        UPDATE novel SET deleted = 1
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 回写统计字段：子查询 + 聚合函数 SUM / COUNT / IFNULL -->
    <update id="refreshStatByChapter" flushCache="true">
        UPDATE novel
        SET chapter_count = (SELECT COUNT(*) FROM chapter WHERE novel_id = #{novelId}),
            word_count    = (SELECT IFNULL(SUM(word_count), 0) FROM chapter WHERE novel_id = #{novelId})
        WHERE id = #{novelId}
    </update>

</mapper>
